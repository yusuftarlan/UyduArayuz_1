<UserControl x:Class="TeknofestUyduArayuz.Components.InstantTelemetryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Paket No:" Foreground="LightGray" Margin="0,3"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CurrentPacket.PacketNo}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Uydu Statüsü:" Foreground="LightGray" Margin="0,3"/>
            <TextBlock Grid.Row="1" Grid.Column="1"
                       Text="{Binding CurrentPacket.SatelliteStatus}"
                       Foreground="White" FontWeight="Bold" HorizontalAlignment="Right"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Hata Kodu:" Foreground="LightGray" Margin="0,3"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CurrentPacket.ErrorCode}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Gönderme Saati:" FontFamily="Consolas" Foreground="LightGray" Margin="0,3"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CurrentPacket.SentDate, StringFormat={}{0:dd.MM.yyyy HH:mm:ss}}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Basınç (Pa):" FontFamily="Consolas" Foreground="LightGray" Margin="0,3"/>
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CurrentPacket.Pressure}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Yükseklik (m):" FontFamily="Consolas" Foreground="LightGray" Margin="0,3"/>
            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding CurrentPacket.Height}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right"/>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="İniş Hızı (m/s):" Foreground="LightGray" Margin="0,3"/>
            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding CurrentPacket.LandingSpeed}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right"/>

            <TextBlock Grid.Row="7" Grid.Column="0" Text="Sıcaklık (°C):" Foreground="LightGray" Margin="0,3"/>
            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding CurrentPacket.Tempreture}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right"/>

            <TextBlock Grid.Row="8" Grid.Column="0" Text="Pil Gerilimi (V):" Foreground="LightGray" Margin="0,3"/>
            <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding CurrentPacket.BatteryVoltage}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right"/>

            <TextBlock Grid.Row="9" Grid.Column="0" Text="GPS Lat:" Foreground="LightGray" Margin="0,3"/>
            <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding CurrentPacket.GpsLatitude}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right"/>

            <TextBlock Grid.Row="10" Grid.Column="0" Text="GPS Long:" Foreground="LightGray" Margin="0,3"/>
            <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding CurrentPacket.GpsLongitude}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right"/>

            <TextBlock Grid.Row="11" Grid.Column="0" Text="GPS Alt (m):" Foreground="LightGray" Margin="0,3"/>
            <TextBlock Grid.Row="11" Grid.Column="1" Text="{Binding CurrentPacket.GpsAltitude}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right"/>

            <TextBlock Grid.Row="12" Grid.Column="0" Text="Pitch (°):" Foreground="LightGray" Margin="0,3"/>
            <TextBlock Grid.Row="12" Grid.Column="1" Text="{Binding CurrentPacket.Pitch}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right"/>

            <TextBlock Grid.Row="13" Grid.Column="0" Text="Roll (°):" Foreground="LightGray" Margin="0,3"/>
            <TextBlock Grid.Row="13" Grid.Column="1" Text="{Binding CurrentPacket.Roll}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right"/>

            <TextBlock Grid.Row="14" Grid.Column="0" Text="Yaw (°):" Foreground="LightGray" Margin="0,3"/>
            <TextBlock Grid.Row="14" Grid.Column="1" Text="{Binding CurrentPacket.Yaw}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right"/>

            <TextBlock Grid.Row="15" Grid.Column="0" Text="Görev Kodu:" Foreground="LightGray" Margin="0,3"/>
            <TextBlock Grid.Row="15" Grid.Column="1" Text="{Binding CurrentPacket.TaskCode}" Foreground="#FFD700" FontWeight="Bold" HorizontalAlignment="Right"/>

            <TextBlock Grid.Row="16" Grid.Column="0" Text="Takım No:" Foreground="LightGray" Margin="0,3"/>
            <TextBlock Grid.Row="16" Grid.Column="1" Text="{Binding CurrentPacket.TeamNo}" Foreground="#FFD700" FontWeight="Bold" HorizontalAlignment="Right"/>

        </Grid>
    </ScrollViewer>
</UserControl>
