<UserControl x:Class="TeknofestUyduArayuz.Components.HeaderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="CommandTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#1B2B3E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#2980B9"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5,0"/>

            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#2A2A2A"/>
                    <Setter Property="Foreground" Value="#555555"/>
                    <Setter Property="BorderBrush" Value="#3A3A3A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="RefreshIconButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource AppActionButtonStyle}">
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderBrush" Value="#334155"/>
        </Style>

        <Style x:Key="ModernButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource AppActionButtonStyle}">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="LedStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Fill" Value="#2ECC71"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="{Binding Fill.Color, RelativeSource={RelativeSource AncestorType=Ellipse}}" 
                              BlurRadius="6" ShadowDepth="0"/>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="0.75*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="0.9*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1.25*"/>
                <ColumnDefinition Width="1.15*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Command="{Binding HeaderControlViewModel.RefreshPortsCommand}"
                    IsEnabled="{Binding HeaderControlViewModel.AreSettingsEnabled}"
                    Style="{StaticResource RefreshIconButtonStyle}"
                    Content="🔄" Margin="0,0,4,0" ToolTip="Portları Yenile"
                    />

            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding HeaderControlViewModel.AvailablePorts}"
                      IsEnabled="{Binding HeaderControlViewModel.AreSettingsEnabled}"
                      SelectedItem="{Binding HeaderControlViewModel.SelectedPort}"
                      HorizontalContentAlignment="Center" 
                      VerticalContentAlignment="Center"
                      MinWidth="70" MaxWidth="110" Height="30" Margin="0,0,6,0"
                      Padding="2,0,16,0"
                      />

            <ComboBox Grid.Column="2"
                      ItemsSource="{Binding HeaderControlViewModel.BaudRates}"
                      IsEnabled="{Binding HeaderControlViewModel.AreSettingsEnabled}"
                      SelectedItem="{Binding HeaderControlViewModel.SelectedBaudRate}"
                      HorizontalContentAlignment="Center" 
                      VerticalContentAlignment="Center"
                      MinWidth="80" MaxWidth="120" Height="30" Margin="0,0,6,0"
                      Padding="2,0,16,0"
                     />

            <Button Grid.Column="3" Content="BAĞLAN"
                    Command="{Binding HeaderControlViewModel.ConnectCommand}"
                    IsEnabled="{Binding HeaderControlViewModel.AreSettingsEnabled}"
                    Style="{StaticResource ModernButtonStyle}"
                    Background="#047857" BorderBrush="#059669"
                    MinWidth="78" MaxWidth="110" Margin="0,0,6,0"
            />

            <Button Grid.Column="4" Content="KES"
                    Command="{Binding HeaderControlViewModel.DisconnectCommand}"
                    IsEnabled="{Binding HeaderControlViewModel.IsConnected}"
                    Style="{StaticResource ModernButtonStyle}"
                    Background="#B91C1C" BorderBrush="#DC2626"
                    MinWidth="56" MaxWidth="80" Margin="0,0,8,0"
            />

            <TextBlock Grid.Column="5" Text="Görev Kodu" Foreground="#CFE0D9"
                       VerticalAlignment="Center" Margin="0,0,6,0"
                       FontSize="11" FontWeight="Bold"
                       ToolTip="Görev Kodu"/>
            <TextBox Grid.Column="6" MinWidth="70" MaxWidth="100" Height="30"
                      Margin="0,0,6,0" Padding="4"
                      Style="{StaticResource CommandTextBoxStyle}"
                      IsEnabled="{Binding HeaderControlViewModel.CanSendCommands}"
                      Text="{Binding HeaderControlViewModel.MissionCode, UpdateSourceTrigger=PropertyChanged}"
                      VerticalContentAlignment="Center" MaxLength="3"
                      ToolTip="3 haneli görev kodu"/>
            <Button Grid.Column="7" Content="GÖNDER" MinWidth="72" MaxWidth="100"
                    Margin="0,0,8,0"
                    Command="{Binding HeaderControlViewModel.SendMissionCodeCommand}"
                    Style="{StaticResource ModernButtonStyle}"
                    Background="#1D4ED8" BorderBrush="#2563EB"
                    IsEnabled="{Binding HeaderControlViewModel.CanSendCommands}"/>

            <Button Grid.Column="8" Content="PARAŞÜT AÇ"
                    MinWidth="92" MaxWidth="130"
                    Command="{Binding HeaderControlViewModel.OpenParachuteCommand}"
                    Background="#B45309" BorderBrush="#D97706"
                    Margin="0,0,6,0" ToolTip="Paraşüt Aç Komutu"
                    Style="{StaticResource ModernButtonStyle}"
                    IsEnabled="{Binding HeaderControlViewModel.CanSendCommands}"/>

            <Button Grid.Column="9" Content="AYRILMA"
                    MinWidth="84" MaxWidth="120"
                    Command="{Binding HeaderControlViewModel.SeparationCommand}"
                    Margin="0,0,0,0" ToolTip="Ayrılma Komutu"
                    Background="#BE123C" BorderBrush="#E11D48"
                    Style="{StaticResource ModernButtonStyle}"
                    IsEnabled="{Binding HeaderControlViewModel.CanSendCommands}"/>
        </Grid>

        <Border Grid.Column="1" Margin="0,0,8,0"
                Background="#0F172A" BorderBrush="#334155" BorderThickness="1"
                CornerRadius="6" Height="36">

                <UniformGrid Rows="1" HorizontalAlignment="Stretch">

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Ellipse Style="{StaticResource LedStyle}"  Fill="{Binding AlarmPanelViewModel.LandingSpeedErrorLed}"/>
                        <TextBlock Text="İniş" Foreground="White" FontSize="10"/>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Ellipse Style="{StaticResource LedStyle}" Fill="{Binding AlarmPanelViewModel.GpsErrorLed}" />
                        <TextBlock Text="GPS" Foreground="White" FontSize="10"/>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Ellipse Style="{StaticResource LedStyle}" Fill="{Binding AlarmPanelViewModel.SeperationErrorLed}"  />
                        <TextBlock Text="Ayrılma" Foreground="White" FontSize="10"/>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Ellipse Style="{StaticResource LedStyle}" Fill="{Binding AlarmPanelViewModel.EmergencyParachuteErrorLed}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Paraşüt" Foreground="White" FontSize="10"/>
                    </StackPanel>

                </UniformGrid>
        </Border>

        <Border Grid.Column="2" Background="#0F172A" BorderBrush="#334155"
                BorderThickness="1" CornerRadius="4" Padding="8,5">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">

                <Ellipse Width="10" Height="10" Fill="{Binding HeaderControlViewModel.SystemStatusColor}" Margin="0,0,8,0"/>

                <TextBlock Text="{Binding HeaderControlViewModel.SystemStatus}"
                           ToolTip="{Binding HeaderControlViewModel.SystemStatus}"
                           Width="158" TextTrimming="CharacterEllipsis"
                           Foreground="{Binding HeaderControlViewModel.SystemStatusColor}"
                           FontSize="11" FontWeight="Bold" VerticalAlignment="Center"
                           FontFamily="Consolas"/>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
