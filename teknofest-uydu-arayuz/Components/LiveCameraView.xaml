<UserControl x:Class="TeknofestUyduArayuz.Components.LiveCameraView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <Border BorderBrush="#475569"
            BorderThickness="1"
            Margin="2"
            CornerRadius="4"
            Background="#1E293B">

        <Grid Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="Black"
                    Margin="2">
                <Image x:Name="UsbCameraImage"
                       Stretch="Uniform"
                       SnapsToDevicePixels="True"/>
            </Border>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="2">
                <Button x:Name="StartButton"
                        Style="{StaticResource AppActionButtonStyle}"
                        Background="#047857"
                        BorderBrush="#059669"
                        Content="Başlat"
                        Margin="2,4"
                        Click="StartStream_Click"/>

                <TextBlock Text="Kamera No:"
                           Foreground="#CBD5E1"
                           VerticalAlignment="Center"
                           Margin="8,2,2,2"/>

                <TextBox Width="36"
                         Height="30"
                         Margin="2,4"
                         Padding="4,0"
                         Foreground="#F8FAFC"
                         Background="#0F172A"
                         BorderBrush="#475569"
                         TextAlignment="Center"
                         VerticalContentAlignment="Center"
                         Text="{Binding CameraIndex,
                                        RelativeSource={RelativeSource AncestorType=UserControl},
                                        UpdateSourceTrigger=PropertyChanged}"/>

                <Button x:Name="StopButton"
                        Style="{StaticResource AppActionButtonStyle}"
                        Background="#B91C1C"
                        BorderBrush="#DC2626"
                        Content="Durdur"
                        Margin="2,4"
                        Click="StopStream_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
