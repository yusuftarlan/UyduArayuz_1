<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>teknofest-uydu-arayuz</AssemblyName>
    <RootNamespace>TeknofestUyduArayuz</RootNamespace>
    <Product>teknofest-uydu-arayuz</Product>
    <AssemblyTitle>teknofest-uydu-arayuz</AssemblyTitle>
    <Description>Seri telemetri, görev komutları, USB kamera ve yer istasyonu görselleştirmeleri için masaüstü uygulaması.</Description>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <NeutralLanguage>tr-TR</NeutralLanguage>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <!-- SerialDiagnostics yalnız Debug derlemesinde gerçek bir konsola yazabilsin. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HelixToolkit.Wpf" Version="3.1.2" />
    <PackageReference Include="Mapsui.Wpf" Version="4.1.8" />
    <PackageReference Include="OxyPlot.Wpf" Version="2.2.0" />
    <PackageReference Include="OpenCvSharp4.Windows" Version="4.13.0.20260627" />
    <PackageReference Include="System.IO.Ports" Version="10.0.6" />
  </ItemGroup>

  <ItemGroup>
    <None Update="body-model\counsat.stl">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="sound\warning.mp3">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
