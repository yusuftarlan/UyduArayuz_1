<UserControl x:Class="UyduArayuz_1.Components.CenterDisplayArea"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UyduArayuz_1.Components"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80*"/>
            <RowDefinition Height="20*"/>
            <RowDefinition Height="20*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20*"/>
            <ColumnDefinition Width="80*"/>
        </Grid.ColumnDefinitions>

        <local:InstantTelemetryPanel Grid.Column="0" MaxWidth="350" Background="#2C3E50" Margin="5"/>
        <local:LogPanel Grid.Row="1" MaxWidth="350" Background="#2C3E50" Margin="5"/>

        <local:GraphDashboard Grid.Column="1" Grid.RowSpan="2" Background="#2C3E50" Margin="5"/>

        <local:TelemetryTable Grid.Row="2" Grid.ColumnSpan="2" Background="#2C3E50" Margin="5"/>



    </Grid>
</UserControl>