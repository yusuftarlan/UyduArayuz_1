<UserControl x:Class="UyduArayuz_1.Components.TelemetryTable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UyduArayuz_1.Components"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="5">
        <Grid.RowDefinitions>
           
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="HistoryGrid" 
         Grid.Row="1"
          ItemsSource="{Binding TelemetryHistory}"
          AutoGenerateColumns="False" 
          IsReadOnly="True"
          VerticalScrollBarVisibility="Auto"
          Background="#1E293B" 
          RowBackground="#2C3E50" 
          AlternatingRowBackground="#1E293B"
          Foreground="#F8FAFC"
          
          GridLinesVisibility="Horizontal"
          HorizontalGridLinesBrush="#334155"
          BorderThickness="1" 
          BorderBrush="#334155"
          
          HeadersVisibility="Column"
          VirtualizingStackPanel.IsVirtualizing="True"
          VirtualizingStackPanel.VirtualizationMode="Recycling">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#1B2631"/>
                    <Setter Property="Foreground" Value="#38BDF8"/>
                    <Setter Property="Padding" Value="8,5"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="BorderBrush" Value="#334155"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Paket No" Binding="{Binding PacketNo}" Width="70"/>
                <DataGridTextColumn Header="Statü" Binding="{Binding SatelliteStatus}" Width="60"/>
                <DataGridTextColumn Header="Hata" Binding="{Binding ErrorCode}" Width="50"/>
                <DataGridTextColumn Header="Gönderme Saati" Binding="{Binding SentDate}" Width="80"/>

                <DataGridTextColumn Header="Basınç (Pa)" Binding="{Binding Pressure}" Width="85"/>
                <DataGridTextColumn Header="Yükseklik (m)" Binding="{Binding Height}" Width="85"/>
                <DataGridTextColumn Header="Hız (m/s)" Binding="{Binding LandingSpeed}" Width="70"/>
                <DataGridTextColumn Header="Sıcaklık (°C)" Binding="{Binding Tempreture}" Width="80"/>
                <DataGridTextColumn Header="Pil (V)" Binding="{Binding BatteryVoltage}" Width="50"/>

                <DataGridTextColumn Header="GPS Lat" Binding="{Binding GpsLatitude}" Width="80"/>
                <DataGridTextColumn Header="GPS Long" Binding="{Binding GpsLongitude}" Width="80"/>
                <DataGridTextColumn Header="GPS Alt (m)" Binding="{Binding GpsAltitude}" Width="80"/>

                <DataGridTextColumn Header="Pitch (°)" Binding="{Binding Pitch}" Width="60"/>
                <DataGridTextColumn Header="Roll (°)" Binding="{Binding Roll}" Width="60"/>
                <DataGridTextColumn Header="Yaw (°)" Binding="{Binding Yaw}" Width="60"/>

                <DataGridTextColumn Header="RHRHRH*" Binding="{Binding TaskCode}" Width="80"/>
                <DataGridTextColumn Header="Takım No" Binding="{Binding TeamNo}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</UserControl>
