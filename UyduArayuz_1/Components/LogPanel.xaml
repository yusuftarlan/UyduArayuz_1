<UserControl x:Class="UyduArayuz_1.Components.LogPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UyduArayuz_1.Components"
             xmlns:services="clr-namespace:UyduArayuz_1.Services"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <ListBox x:Name="TerminalListBox"
         ItemsSource="{Binding Path=Logs, Source={x:Static services:LoggerService.Instance}}"
         Background="#1E1E1E" 
         FontFamily="Consolas"
         BorderThickness="0"
         Padding="5"
         ScrollViewer.HorizontalScrollBarVisibility="Disabled">

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Foreground" Value="#4ADE80"/>
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Padding" Value="0,2"/>

                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Level}" Value="ERROR">
                            <Setter Property="Foreground" Value="#EF4444"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding Level}" Value="WARN">
                            <Setter Property="Foreground" Value="#FACC15"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </Grid>
</UserControl>
