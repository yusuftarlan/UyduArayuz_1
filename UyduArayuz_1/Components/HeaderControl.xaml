<UserControl x:Class="UyduArayuz_1.Components.HeaderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        

        <Style x:Key="CommandTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#1B2B3E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#2980B9"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5,0"/>

            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#2A2A2A"/>
                    <Setter Property="Foreground" Value="#555555"/>
                    <Setter Property="BorderBrush" Value="#3A3A3A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="RefreshIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                        Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}" 
                        BorderThickness="{TemplateBinding BorderThickness}" 
                        CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                        Background="{TemplateBinding Background}"
                        CornerRadius="4" 
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.60"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LedStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Fill" Value="#2ECC71"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="{Binding Fill.Color, RelativeSource={RelativeSource AncestorType=Ellipse}}" 
                              BlurRadius="10" ShadowDepth="0"/>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Cursor="">

            <Button Command="{Binding HeaderControlViewModel.RefreshPortsCommand}"
                    IsEnabled="{Binding HeaderControlViewModel.AreSettingsEnabled}"
                    Style="{StaticResource RefreshIconButtonStyle}"
                    Content="🔄" Width="30" Margin="0,0,5,0" ToolTip="Portları Yenile"
                    />

            <ComboBox ItemsSource="{Binding HeaderControlViewModel.AvailablePorts}" 
                      IsEnabled="{Binding HeaderControlViewModel.AreSettingsEnabled}"
                      SelectedItem="{Binding HeaderControlViewModel.SelectedPort}"
                      HorizontalContentAlignment="Center" 
                      VerticalContentAlignment="Center"
                      Width="80" Height="30" Margin="0,0,10,0" Padding="2,0,18,0"
                      />

            <ComboBox ItemsSource="{Binding HeaderControlViewModel.BaudRates}" 
                      IsEnabled="{Binding HeaderControlViewModel.AreSettingsEnabled}"
                      SelectedItem="{Binding HeaderControlViewModel.SelectedBaudRate}"
                      HorizontalContentAlignment="Center" 
                      VerticalContentAlignment="Center"
                      Width="80" Height="30" Margin="0,0,10,0" Padding="2,0,18,0"
                     />

            <Button Content="BAĞLAN" Command="{Binding HeaderControlViewModel.ConnectCommand}" 
                    IsEnabled="{Binding HeaderControlViewModel.AreSettingsEnabled}"
                    Style="{StaticResource ModernButtonStyle}"
                    Background="#10B981"
                    Width="80" Height="28" Margin="0,0,15,0"
            />

            <Button Content="KES" Command="{Binding HeaderControlViewModel.DisconnectCommand}" 
                    IsEnabled="{Binding HeaderControlViewModel.IsConnected}"
                    Style="{StaticResource ModernButtonStyle}"
                    Background="#EF4444"
                    Width="50" Height="28" Margin="0,0,15,0"
            />

            <Rectangle Width="1" Fill="#334155" Margin="5,0,5,0" Height="25"/>

            <TextBlock Text="Görev Kodu:" Foreground="#FFCFE0D9" VerticalAlignment="Center" Margin="0,0,10,0"
                       FontWeight="Bold"/>
            <TextBox x:Name="txtMissionCode" Width="100" Margin="0,0,5,0" Padding="5" 
                      Style="{StaticResource CommandTextBoxStyle}"
                      IsEnabled="{Binding HeaderControlViewModel.IsConnected}"
                      Text="{Binding HeaderControlViewModel.MissionCode, UpdateSourceTrigger=PropertyChanged}"
                      VerticalContentAlignment="Center" MaxLength="3"/>
            <Button x:Name="btnSendCommand" Content="GÖNDER" Margin="0,0,5,0" Padding="5" 
                    Command="{Binding HeaderControlViewModel.SendMissionCodeCommand}"
                    Style="{StaticResource ModernButtonStyle}"
                    Background="#64748B"
                    IsEnabled="{Binding HeaderControlViewModel.IsConnected}"/>

            <Rectangle Width="1" Fill="#334155" Margin="5,0,5,0" Height="25"/>

            <Button x:Name="btnCalibrate" Content="Paraşüt Aç Komutu"
                    Command="{Binding HeaderControlViewModel.OpenParachuteCommand}"
                    Background="#D97706"
                    Height="28" Margin="0,0,10,0"
                    Style="{StaticResource ModernButtonStyle}"
                    IsEnabled="{Binding HeaderControlViewModel.IsConnected}"/>

            <Button x:Name="btnRelease" Content="Ayrılma Komutu"
                    Command="{Binding HeaderControlViewModel.SeparationCommand}"
                    Margin="0,0,5,0" Padding="5"
                    Background="#E11D48"
                    Height="28"
                    Style="{StaticResource ModernButtonStyle}"
                    IsEnabled="{Binding HeaderControlViewModel.IsConnected}"/>

            <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6"  Height="40" Width="200" >

                <UniformGrid Rows="1" HorizontalAlignment="Stretch">

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Ellipse Style="{StaticResource LedStyle}"  Fill="{Binding AlarmPanelViewModel.LandingSpeedErrorLed}"/>
                        <TextBlock Text="İniş" Foreground="White" />
                    </StackPanel>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Ellipse Style="{StaticResource LedStyle}" Fill="{Binding AlarmPanelViewModel.GpsErrorLed}" />
                        <TextBlock Text="GPS" Foreground="White" />
                    </StackPanel>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Ellipse Style="{StaticResource LedStyle}" Fill="{Binding AlarmPanelViewModel.SeperationErrorLed}"  />
                        <TextBlock Text="Ayrılma" Foreground="White"  />
                    </StackPanel>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Ellipse Style="{StaticResource LedStyle}" Fill="{Binding AlarmPanelViewModel.EmergencyParachuteErrorLed}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Paraşüt" Foreground="White" />
                    </StackPanel>

                </UniformGrid>
            </Border>

        </StackPanel>

        <Border Grid.Column="1" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" MinWidth="240" Padding="10,5">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">

                <Ellipse x:Name="elStatusIndicator" Width="12" Height="12" Fill="{Binding HeaderControlViewModel.SystemStatusColor}" Margin="0,0,10,0"/>

                <TextBlock x:Name="txtDetailedStatus" Text="{Binding HeaderControlViewModel.SystemStatus}" 
                           Foreground="{Binding HeaderControlViewModel.SystemStatusColor}" FontWeight="Bold" VerticalAlignment="Center" FontFamily="Consolas"/>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
